  {
    "name": "ptah_propose_repair",
    "title": "Propose bounded repair",
    "description": "Use this to get the bounded repair proposal on file for a synthetic finding: files in scope, required tests, rollback and the approvals it needs. The proposal is text only; this tool applies no change.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^FND-[A-Z0-9-]{1,40}$",
          "description": "Identifier starting with FND-"
        }
      },
      "required": [
        "finding_id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "const": "PTAH"
        },
        "data_classification": {
          "type": "string",
          "const": "SYNTHETIC"
        },
        "fixture_set": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "properties": {
            "finding_id": {
              "type": "string"
            },
            "proposal": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "PROPOSED_NOT_APPLIED"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "files_in_scope": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "tests_required": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rollback": {
                      "type": "string"
                    },
                    "required_approvals": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "status",
                    "summary",
                    "files_in_scope",
                    "tests_required",
                    "rollback",
                    "required_approvals"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason_if_none": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "finding_id",
            "proposal",
            "reason_if_none"
          ],
          "additionalProperties": false
        },
        "receipt": {
          "type": "object",
          "properties": {
            "receipt_id": {
              "type": "string"
            },
            "sequence": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "receipt_sha256": {
              "type": "string"
            }
          },
          "required": [
            "receipt_id",
            "sequence",
            "receipt_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "node",
        "data_classification",
        "fixture_set",
        "result",
        "receipt"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Propose bounded repair",
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false,
      "idempotentHint": true
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "suite:ptah.read"
        ]
      }
    ],
    "_meta": {
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "suite:ptah.read"
          ]
        }
      ]
    }
