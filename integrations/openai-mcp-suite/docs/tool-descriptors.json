[
  {
    "name": "theia_get_workstream_status",
    "title": "Get workstream status",
    "description": "Use this to read the current status and gates of a MIRRORNODE workstream from the synthetic fixture set. Returns each gate with its owner role, open/closed state and evidence class. Read-only; it changes nothing.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workstream_id": {
          "description": "Workstream id. Omit to list all workstreams.",
          "type": "string",
          "pattern": "^WS-[A-Z0-9-]{1,40}$"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "const": "THEIA"
        },
        "data_classification": {
          "type": "string",
          "const": "SYNTHETIC"
        },
        "fixture_set": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "properties": {
            "workstreams": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "gates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "owner_role": {
                          "type": "string"
                        },
                        "state": {
                          "type": "string",
                          "enum": [
                            "OPEN",
                            "CLOSED"
                          ]
                        },
                        "evidence_class": {
                          "type": "string",
                          "enum": [
                            "OBSERVED",
                            "REPORTED",
                            "INFERRED",
                            "BLOCKED",
                            "UNKNOWN"
                          ]
                        },
                        "evidence_ref": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "description",
                        "owner_role",
                        "state",
                        "evidence_class",
                        "evidence_ref"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "open_gate_count": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "id",
                  "title",
                  "status",
                  "summary",
                  "gates",
                  "open_gate_count"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "workstreams"
          ],
          "additionalProperties": false
        },
        "receipt": {
          "type": "object",
          "properties": {
            "receipt_id": {
              "type": "string"
            },
            "sequence": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "receipt_sha256": {
              "type": "string"
            }
          },
          "required": [
            "receipt_id",
            "sequence",
            "receipt_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "node",
        "data_classification",
        "fixture_set",
        "result",
        "receipt"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Get workstream status",
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false,
      "idempotentHint": true
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "suite:theia.read"
        ]
      }
    ],
    "_meta": {
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "suite:theia.read"
          ]
        }
      ]
    }
  },
  {
    "name": "theia_list_next_actions",
    "title": "List next actions",
    "description": "Use this to see which next actions on a workstream are unblocked or blocked by open gates, and which need Operator approval. It reports status only: it grants no authorization and executes nothing.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workstream_id": {
          "type": "string",
          "pattern": "^WS-[A-Z0-9-]{1,40}$",
          "description": "Identifier starting with WS-"
        }
      },
      "required": [
        "workstream_id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "const": "THEIA"
        },
        "data_classification": {
          "type": "string",
          "const": "SYNTHETIC"
        },
        "fixture_set": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "properties": {
            "workstream_id": {
              "type": "string"
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "required_authority": {
                    "type": "string"
                  },
                  "reversible": {
                    "type": "boolean"
                  },
                  "blocked_by_open_gates": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "UNBLOCKED",
                      "BLOCKED"
                    ]
                  },
                  "operator_approval_required": {
                    "type": "boolean"
                  },
                  "executable_by_this_server": {
                    "type": "boolean",
                    "const": false
                  }
                },
                "required": [
                  "id",
                  "description",
                  "required_authority",
                  "reversible",
                  "blocked_by_open_gates",
                  "state",
                  "operator_approval_required",
                  "executable_by_this_server"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "workstream_id",
            "actions"
          ],
          "additionalProperties": false
        },
        "receipt": {
          "type": "object",
          "properties": {
            "receipt_id": {
              "type": "string"
            },
            "sequence": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "receipt_sha256": {
              "type": "string"
            }
          },
          "required": [
            "receipt_id",
            "sequence",
            "receipt_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "node",
        "data_classification",
        "fixture_set",
        "result",
        "receipt"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "List next actions",
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false,
      "idempotentHint": true
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "suite:theia.read"
        ]
      }
    ],
    "_meta": {
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "suite:theia.read"
          ]
        }
      ]
    }
  },
