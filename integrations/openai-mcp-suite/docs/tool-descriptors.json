  {
    "name": "ptah_get_readiness",
    "title": "Get implementation readiness",
    "description": "Use this to summarize implementation readiness of a synthetic component: its readiness label, the evidence behind each claim and its open findings with their recorded security status. Read-only.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^CMP-[A-Z0-9-]{1,40}$",
          "description": "Identifier starting with CMP-"
        }
      },
      "required": [
        "component_id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "const": "PTAH"
        },
        "data_classification": {
          "type": "string",
          "const": "SYNTHETIC"
        },
        "fixture_set": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "properties": {
            "component_id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "readiness": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "claim": {
                    "type": "string"
                  },
                  "evidence_class": {
                    "type": "string",
                    "enum": [
                      "OBSERVED",
                      "REPORTED",
                      "INFERRED",
                      "BLOCKED",
                      "UNKNOWN"
                    ]
                  },
                  "ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "claim",
                  "evidence_class",
                  "ref"
                ],
                "additionalProperties": false
              }
            },
            "unverified_claims": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "open_findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "disposition_status": {
                    "type": "string",
                    "enum": [
                      "HOLD",
                      "CLEARED",
                      "CLEARED_WITH_CONDITIONS",
                      "PENDING_THOTH_REVIEW"
                    ]
                  }
                },
                "required": [
                  "id",
                  "severity",
                  "title",
                  "disposition_status"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "component_id",
            "title",
            "readiness",
            "evidence",
            "unverified_claims",
            "open_findings"
          ],
          "additionalProperties": false
        },
        "receipt": {
          "type": "object",
          "properties": {
            "receipt_id": {
              "type": "string"
            },
            "sequence": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "receipt_sha256": {
              "type": "string"
            }
          },
          "required": [
            "receipt_id",
            "sequence",
            "receipt_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "node",
        "data_classification",
        "fixture_set",
        "result",
        "receipt"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Get implementation readiness",
