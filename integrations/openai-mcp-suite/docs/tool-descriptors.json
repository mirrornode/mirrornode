          "type": "object",
          "properties": {
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  },
                  "component_id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "evidence_class": {
                    "type": "string",
                    "enum": [
                      "OBSERVED",
                      "REPORTED",
                      "INFERRED",
                      "BLOCKED",
                      "UNKNOWN"
                    ]
                  },
                  "disposition_status": {
                    "type": "string",
                    "enum": [
                      "HOLD",
                      "CLEARED",
                      "CLEARED_WITH_CONDITIONS",
                      "PENDING_THOTH_REVIEW"
                    ]
                  }
                },
                "required": [
                  "id",
                  "severity",
                  "component_id",
                  "title",
                  "evidence_class",
                  "disposition_status"
                ],
                "additionalProperties": false
              }
