          "type": "string",
          "const": "SYNTHETIC"
        },
        "fixture_set": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "properties": {
            "chain": {
              "type": "object",
              "properties": {
                "valid": {
                  "type": "boolean"
                },
                "checked": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "first_invalid_sequence": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "valid",
                "checked",
                "first_invalid_sequence"
              ],
              "additionalProperties": false
            },
            "receipts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "receipt_id": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "tool": {
                    "type": "string"
                  },
                  "outcome": {
                    "type": "string"
                  },
                  "invoked_at": {
                    "type": "string"
                  },
                  "receipt_sha256": {
                    "type": "string"
                  }
                },
                "required": [
                  "receipt_id",
                  "sequence",
                  "tool",
                  "outcome",
                  "invoked_at",
                  "receipt_sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "chain",
            "receipts"
          ],
          "additionalProperties": false
        },
        "receipt": {
          "type": "object",
          "properties": {
            "receipt_id": {
              "type": "string"
            },
            "sequence": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "receipt_sha256": {
              "type": "string"
            }
          },
          "required": [
            "receipt_id",
            "sequence",
            "receipt_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "node",
        "data_classification",
        "fixture_set",
        "result",
        "receipt"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Verify evidence receipts",
      "readOnlyHint": true,
